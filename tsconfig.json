{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "ESNext",
      "WebWorker",
      "DOM"
    ],
    "types": [
      "./worker-configuration.d.ts",
      "node"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "outDir": "dist",
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}