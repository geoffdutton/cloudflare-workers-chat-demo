{
  "name": "edge-chat-demo",
  "description": "An edge chat service that runs on Cloudflare Workers using Durable Objects",
  "version": "1.0.0",
  "module": "./src/chat.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run cf-typegen && npm run typecheck && vite build",
    "dev": "vite dev",
    "deploy": "wrangler publish",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^0.1.10",
    "prettier": "^3.5.3",
    "typescript": "^5.4.2",
    "vite": "^6.2.1",
    "wrangler": "^4.0.0"
  }
}
